{
  "name": "@sderickson/home-2026",
  "description": "My Home App Made in 2026",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @sderickson/hub-auth-spa -w @sderickson/recipes-app-spa -w @sderickson/recipes-security --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "typecheck": "vue-tsc -b"
  },
  "author": "Scott Erickson <sderickson@gmail.com>",
  "workspaces": [
    "clients/**",
    "hub/**",
    "hub/deploy/**",
    "notebook/**",
    "recipes/**",
    "saflib/**"
  ],
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@saflib/monorepo": "*",
    "@types/nodemailer": "^8.0.0"
  },
  "overrides": {
    "vue-router": "^5.0.0",
    "vuetify": "^4.1.6",
    "vite": "8.1.7",
    "rolldown": "~1.1.7",
    "better-sqlite3": "12.11.1",
    "vue": "3.5.45",
    "@vue/compiler-core": "3.5.45",
    "@vue/compiler-dom": "3.5.45",
    "@vue/compiler-sfc": "3.5.45",
    "@vue/compiler-ssr": "3.5.45",
    "@vue/reactivity": "3.5.45",
    "@vue/runtime-core": "3.5.45",
    "@vue/runtime-dom": "3.5.45",
    "@vue/server-renderer": "3.5.45",
    "@vue/shared": "3.5.45",
    "@types/node": "^24.3.0",
    "typescript": "~6.0.0",
    "msw": "2.12.7",
    "drizzle-kit": "^0.31.10",
    "@tanstack/vue-query": "5.85.9",
    "@vitejs/plugin-vue": "6.0.10",
    "editorconfig": {
      "commander": "^15.0.0"
    },
    "eslint": "10.11.0"
  },
  "safImports": {
    "boundaries": {
      "baseline": "recipes/import-boundaries.baseline.json",
      "scope": [
        "dir:recipes/**",
        "dir:notebook/**"
      ]
    }
  }
}
