# Edge Caddy env (platform deploy). Product routes use these too, so keep them
# product-agnostic: wildcards over the domain rather than per-product hosts.
# Used by hub/deploy/remote-assets/config/Caddyfile

DOMAIN=scotterickson.info
PROTOCOL=https

# CORS Origin RE2 allowlist ($$ → single $). Keep separate from DNS DOMAIN above.
CORS_ORIGIN_ALLOWLIST=^https://([a-z0-9-]+\.)*scotterickson\.info$$

CSP_SCRIPT_SRC_EXTRA=https://kratos.scotterickson.info
# Product API blobs (api.<product>) + Unsplash hotlinks (recipes)
CSP_IMG_SRC_EXTRA=https://*.scotterickson.info https://images.unsplash.com
CSP_CONNECT_SRC=https: wss:
# Reports go to the recipes API (public route there); hub's API is all behind login.
CSP_REPORT_URI=https://api.recipes.scotterickson.info/csp-violations

# Optional: redirect old/wrong hostnames to main domain (comma-separated)
DOMAIN_REDIRECTS=http://dne.docker.localhost

BLOCK_ADMIN_PAGES=true
