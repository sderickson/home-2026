# Hub's routes on the edge. Registered by this deploy (`saf-deploy up`), which
# fills in {$...} from hub.env (or hub.prod-local.env with --local). Snippets
# (security-headers, kratos-api-proxy, redirect, ...) come from the edge's
# common.Caddyfile.

# Hub client subdomains (served by the hub-web container)

{$PROTOCOL}://{$DOMAIN} {
	import security-headers-marketing
	reverse_proxy hub-web-{$SAF_COLOR}:80
}

{$PROTOCOL}://auth.{$DOMAIN} {
	import security-headers
	reverse_proxy hub-web-{$SAF_COLOR}:80
}

{$PROTOCOL}://app.{$DOMAIN} {
	import security-headers
	reverse_proxy hub-web-{$SAF_COLOR}:80
}

{$PROTOCOL}://admin.{$DOMAIN} {
	import security-headers
	reverse_proxy hub-web-{$SAF_COLOR}:80
}

{$PROTOCOL}://account.{$DOMAIN} {
	import security-headers
	reverse_proxy hub-web-{$SAF_COLOR}:80
}

# Hub API. CORS for the hub SPAs (admin calls /admin/ops-tokens). The ops API
# authenticates by bearer token in Express, so it skips the Kratos whoami
# check; everything else goes through forward_auth.

{$PROTOCOL}://hub.{$DOMAIN} {
	import transport-security
	import cors {$CORS_ORIGINS}
	@public_monolith path /health /ops/*
	handle @public_monolith {
		reverse_proxy hub-monolith-{$SAF_COLOR}:3001 {
			import reverse_proxy_common
		}
	}
	import kratos-api-proxy hub-monolith-{$SAF_COLOR}:3001
}

# Domain redirects (optional)

{$DOMAIN_REDIRECTS} {
	import redirect {$PROTOCOL}://{$DOMAIN}
}
