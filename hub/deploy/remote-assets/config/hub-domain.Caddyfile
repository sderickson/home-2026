# Platform sites: hub clients, hub API and Kratos on the single DOMAIN. Products
# add their own sites from their deploys (see Caddyfile's sites/ import).
# Curried snippets

(hub-spa) {
	import spa /hub-clients {args[0]}
}

(api-proxy-kratos) {
	import transport-security
	import kratos-api-proxy {args[0]}
}

# Hub client subdomains

{$PROTOCOL}://{$DOMAIN} {
	import security-headers-marketing
	import hub-spa /root/index.html
}

{$PROTOCOL}://auth.{$DOMAIN} {
	import security-headers
	import hub-spa /auth/index.html
}

{$PROTOCOL}://app.{$DOMAIN} {
	import security-headers
	import hub-spa /app/index.html
}

{$PROTOCOL}://admin.{$DOMAIN} {
	import security-headers
	import hub-spa /admin/index.html
}

{$PROTOCOL}://account.{$DOMAIN} {
	import security-headers
	import hub-spa /account/index.html
}

# Hub API (forward_auth to Kratos whoami, then proxy to the hub service)

{$PROTOCOL}://hub.{$DOMAIN} {
	import api-proxy-kratos {$HUB_SERVICE_HTTP_HOST}
}

# Kratos public API

{$PROTOCOL}://kratos.{$DOMAIN} {
	import transport-security
	import cors {$CORS_ORIGIN_ALLOWLIST}
	reverse_proxy kratos:4433
}

# Domain redirects (optional)

{$DOMAIN_REDIRECTS} {
	import redirect {$PROTOCOL}://{$DOMAIN}
}
