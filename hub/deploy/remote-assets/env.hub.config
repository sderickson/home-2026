# Hub monolith (platform deploy): Kratos courier + hub service.
# One domain; API subdomains use Kratos whoami in Caddy.

ALLOW_DB_CREATION=true
CLIENT_SUBDOMAINS=,app,auth,account,admin
DEPLOYMENT_NAME=production
DOMAIN=scotterickson.info
MOCK_INTEGRATIONS=false
NODE_ENV=production
PROTOCOL=https

KRATOS_HANDLER_HTTP_HOST=hub-monolith:3000

SERVICE_SUBDOMAINS=hub
TRADEMARK="Hub"
TZ=UTC

HUB_SERVICE_HTTP_HOST=hub-monolith:3001

ADMIN_EMAILS=sderickson@gmail.com
