# Caddy env for prod-local (hub domain model, single monolith)

DOMAIN=docker.localhost
PROTOCOL=http
HUB_SERVICE_HTTP_HOST=monolith:3001
RECIPES_SERVICE_HTTP_HOST=monolith:3002

# CORS Origin RE2 allowlist ($$ → single $). Keep separate from DNS DOMAIN above.
CORS_ORIGIN_ALLOWLIST=^http://((app|admin|account)\.recipes|recipes|app|auth|admin|account)\.docker\.localhost$$|^http://docker\.localhost$$

CSP_SCRIPT_SRC_EXTRA=http://kratos.docker.localhost
# Recipe file blobs (api.recipes) + Unsplash picker thumbnails
CSP_IMG_SRC_EXTRA=http://api.recipes.docker.localhost https://images.unsplash.com
CSP_CONNECT_SRC=http: https: ws: wss:
CSP_REPORT_URI=http://api.recipes.docker.localhost/csp-violations

# Optional redirects (set to a dummy host if none, so Caddy snippet is valid)
DOMAIN_REDIRECTS=http://dne.docker.localhost

BLOCK_ADMIN_PAGES=false

# BEGIN WORKFLOW AREA caddy FOR product/init
# END WORKFLOW AREA
