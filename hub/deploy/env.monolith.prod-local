# Hub monolith for the prod-local platform stack
# Same shape as remote-assets/env.hub.config but DOMAIN=docker.localhost and local settings

ALLOW_DB_CREATION=true
CLIENT_SUBDOMAINS=,app,auth,account,admin
DEPLOYMENT_NAME=prodlocal
DOMAIN=docker.localhost
MOCK_INTEGRATIONS=true
NODE_ENV=production
PROTOCOL=http
ADMIN_EMAILS=admin@docker.localhost
BREVO_API_KEY=mock

KRATOS_HANDLER_HTTP_HOST=monolith:3000

SERVICE_SUBDOMAINS=hub

# Ory Kratos (Express resolves identities via admin API)
TRADEMARK="Hub"
TZ=UTC

HUB_SERVICE_HTTP_HOST=monolith:3001

# Integrations (prod-local)
SENTRY_DSN=mock
INFISICAL_TOKEN=mock
