# Edge reverse proxy (platform deploy). Bakes in hub's own clients; products
# serve their clients from their own containers and register routes into
# /etc/caddy/sites (see remote-assets/config/Caddyfile).
FROM caddy:2.11.2

COPY --from=#{ image @sderickson/hub-deploy/builds/hub-clients }# /dist /srv/hub-clients

COPY ./hub/deploy/remote-assets/config /etc/caddy/
