{
  "extends": "@saflib/monorepo/tsconfig.json",
  "references": [
    {
      "path": "../../../saflib/email/email-service"
    },
    {
      "path": "../../../saflib/node"
    },
    {
      "path": "../../../saflib/ory-kratos/ory-kratos-http"
    }
  ],
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results"
  ],
  "include": ["**/*.ts", "**/*.json"],
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist/types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true
  }
}
