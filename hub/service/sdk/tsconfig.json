{
  "extends": [
    "@saflib/vue/tsconfig.app.json"
  ],
  "references": [
    {
      "path": "../../../saflib/monorepo"
    },
    {
      "path": "../../../saflib/sdk"
    },
    {
      "path": "../../../saflib/vite"
    },
    {
      "path": "../../../saflib/vue"
    },
    {
      "path": "../spec"
    }
  ],
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results",
    "workflows/template/**",
    "workflows/templates/**",
    "**/workflows/template/**",
    "**/workflows/templates/**"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.vue",
    "**/*.json"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist/types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "types": [
      "vite/client"
    ]
  }
}
