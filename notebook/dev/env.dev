# @saflib/env
ALLOW_DB_CREATION=true
DEPLOYMENT_NAME=development
NODE_ENV=development
PROTOCOL=http
TZ=UTC

# notebook-specific @saflib/env
DOMAIN=docker.localhost
# Template stub SPA subdomain is for notebook/dev only; product/init strips it.
# vue/add-spa appends new subdomains to this line.
CLIENT_SUBDOMAINS=,auth,app,admin,account

KRATOS_HANDLER_HTTP_HOST=notebook-monolith:3000
SENTRY_DSN=mock

# @saflib/email-service
BREVO_API_KEY=mock

# @sderickson/notebook-http
NOTEBOOK_SERVICE_HTTP_HOST=notebook-monolith:3001
NOTEBOOK_SERVICE_INTERNAL_SOCKET=/tmp/notebook-internal.sock
NOTEBOOK_SERVICE_JOBS_SOCKET=/tmp/notebook-jobs-internal.sock
SAF_JOBS_SOCKET=/tmp/notebook-jobs-internal.sock

ADMIN_EMAILS=admin@saflib.com
# Client nav chrome (mirrors ADMIN_EMAILS; Vite only exposes VITE_* to the browser)
VITE_ADMIN_EMAILS=admin@saflib.com
