# Client subdomains → vite dev server

http://docker.localhost {
	import security-headers
	import spa /notebook-static-root /index.html
}

http://auth.docker.localhost {
	import security-headers
	reverse_proxy clients:5173 {
		import reverse_proxy_common
	}
}

http://app.docker.localhost {
	import security-headers
	reverse_proxy clients:5173 {
		import reverse_proxy_common
	}
}

http://admin.docker.localhost {
	import security-headers
	reverse_proxy clients:5173 {
		import reverse_proxy_common
	}
}

http://account.docker.localhost {
	import security-headers
	reverse_proxy clients:5173 {
		import reverse_proxy_common
	}
}

# Built (static) saflib dev-site: Express API + SPA on one port. Runs as its
# own stack (`npm run dev-site`), published on the host's port 3099.
http://dev.docker.localhost {
	import security-headers
	reverse_proxy host.docker.internal:3099 {
		import reverse_proxy_common
	}
}

