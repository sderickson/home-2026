{
  "name": "@sderickson/notebook-clients-common",
  "saf": {
    "kind": "vue"
  },
  "description": "Shared look-and-feel and utilities for web clients",
  "private": true,
  "type": "module",
  "exports": {
    "./assets/*": "./assets/*.ts",
    "./clients": "./clients/index.ts",
    "./clients/*": "./clients/*.ts",
    "./components": "./components/index.ts",
    "./components/notebook-layout": "./components/notebook-layout/NotebookLayout.vue",
    "./components/notebook-layout/DynamicNotebookLayout": "./components/notebook-layout/DynamicNotebookLayout.vue",
    "./components/marketing": "./components/marketing/index.ts",
    "./components/*": "./components/*.ts",
    "./composables/*": "./composables/*.ts",
    "./fixtures": "./fixtures/index.ts",
    "./fixtures/*": "./fixtures/*.ts",
    "./utils/*": "./utils/*.ts",
    "./vuetify-config": "./vuetify-config.ts",
    "./style-imports": "./style-imports.ts",
    "./static-site-theme": "./static-site-theme.ts",
    "./strings": "./strings.ts",
    "./i18n": "./i18n.ts",
    "./playwright.config": "./playwright.config.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@saflib/analytics-vue": "*",
    "@sderickson/notebook-links": "*",
    "@sderickson/notebook-sdk": "*",
    "@sderickson/notebook-spec": "*",
    "@saflib/errors-vue": "*",
    "@saflib/links": "*",
    "@saflib/ory-kratos-sdk": "*",
    "@saflib/ory-kratos-spa": "*",
    "@saflib/sdk": "*",
    "@saflib/vue": "*"
  },
  "sideEffects": [
    "./clients/events.ts",
    "./components/marketing/marketing.css",
    "./style-imports.ts",
    "**/*.scss",
    "**/*.css"
  ],
  "imports": {
    "#assets/*": "./assets/*",
    "#clients": "./clients/index.ts",
    "#clients/*": "./clients/*",
    "#components": "./components/index.ts",
    "#components/*": "./components/*",
    "#composables/*": "./composables/*",
    "#fixtures": "./fixtures/index.ts",
    "#fixtures/*": "./fixtures/*",
    "#i18n.ts": "./i18n.ts",
    "#playwright.config.ts": "./playwright.config.ts",
    "#strings.ts": "./strings.ts",
    "#utils/*": "./utils/*",
    "#vuetify-config.ts": "./vuetify-config.ts",
    "#style-imports.ts": "./style-imports.ts"
  },
  "devDependencies": {
    "@saflib/playwright": "*"
  }
}
