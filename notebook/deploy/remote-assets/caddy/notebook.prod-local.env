# Fills in {$...} in notebook.Caddyfile. notebook is a satellite: it sits under its
# identity owner's domain and uses the owner's sign-in and Kratos.
DOMAIN=docker.localhost
PROTOCOL=http
CORS_ORIGINS=^http://((app|admin)\.)?notebook\.docker\.localhost$
CSP_CONNECT_SRC=http://api.notebook.docker.localhost http://kratos.docker.localhost https://us.i.posthog.com https://us-assets.i.posthog.com https://cloudflareinsights.com https://static.cloudflareinsights.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io
CSP_SCRIPT_SRC_EXTRA=http://kratos.docker.localhost
CSP_REPORT_URI=http://api.notebook.docker.localhost/csp-violations
