# Fills in {$...} in notebook.Caddyfile. notebook is a satellite: it sits under its
# identity owner's domain and uses the owner's sign-in and Kratos.
DOMAIN=scotterickson.info
PROTOCOL=https
CORS_ORIGINS=^https://((app|admin)\.)?notebook\.scotterickson\.info$
CSP_CONNECT_SRC=https://api.notebook.scotterickson.info https://kratos.scotterickson.info https://us.i.posthog.com https://us-assets.i.posthog.com https://cloudflareinsights.com https://static.cloudflareinsights.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io
CSP_SCRIPT_SRC_EXTRA=https://kratos.scotterickson.info
CSP_REPORT_URI=https://api.notebook.scotterickson.info/csp-violations
