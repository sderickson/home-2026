# Values for notebook.Caddyfile's {$...} placeholders, filled in when
# this deploy registers its routes. Literal values (no `$$` escaping).
DOMAIN=notebook.scotterickson.info
PROTOCOL=https
# Redirect old/alternate hostnames to DOMAIN.
DOMAIN_REDIRECTS=https://www.notebook.scotterickson.info
# RE2: allowed browser Origins for CORS on api.* and kratos.*.
CORS_ORIGINS=^https://(app|auth|admin|account)\.notebook.scotterickson.info$|^https://notebook.scotterickson.info$
# Space-separated origins for CSP connect-src on HTML sites.
CSP_CONNECT_SRC=https://api.notebook.scotterickson.info https://kratos.notebook.scotterickson.info https://us.i.posthog.com https://us-assets.i.posthog.com https://cloudflareinsights.com https://static.cloudflareinsights.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io
# Kratos public origin for Ory webauthn.js (passkeys).
CSP_SCRIPT_SRC_EXTRA=https://kratos.notebook.scotterickson.info
# Browser CSP violation reports (POST /csp-violations on the product API).
CSP_REPORT_URI=https://api.notebook.scotterickson.info/csp-violations
