# The product's static sites: the marketing root, static subdomains and the
# SPAs. The platform's edge proxies the product's hosts here (see
# remote-assets/caddy/notebook.Caddyfile).
FROM #{ image @sderickson/notebook-root-static }# AS root-builder
RUN npm run build

# BEGIN WORKFLOW AREA build-static-sites FOR vue/add-static-site


# END WORKFLOW AREA

FROM #{ image @sderickson/notebook-clients }# AS clients-builder
COPY ./notebook/deploy/env.monolith.prod-local /app/env.clients
RUN export $(grep -v "^#" /app/env.clients | xargs) && DOMAIN=${DOMAIN} CLIENT_SUBDOMAINS=${CLIENT_SUBDOMAINS} npm run build

FROM caddy:2.11.8-alpine
RUN apk upgrade --no-cache && rm -rf /var/cache/apk/*

COPY --from=root-builder /app/notebook/clients/root/.vitepress/dist /srv/notebook-root

# BEGIN WORKFLOW AREA copy-static-sites FOR vue/add-static-site

# END WORKFLOW AREA

COPY --from=clients-builder /app/notebook/clients/build/dist /srv/notebook-clients

COPY ./notebook/deploy/builds/web/Caddyfile /etc/caddy/Caddyfile
