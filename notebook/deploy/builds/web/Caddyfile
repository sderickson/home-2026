# Serves the product's static files behind the platform's edge, which
# terminates TLS, adds security headers and proxies here with the Host intact.
{
	admin off
	auto_https off
}

(spa) {
	encode gzip
	root * /srv{args[0]}
	@assets path /assets/*
	header @assets >Cache-Control "public, max-age=31536000, immutable"
	file_server {
		pass_thru
	}
	@non-file expression path_regexp('^[^.]*$')
	handle @non-file {
		header >Cache-Control "no-cache, no-store, must-revalidate"
		try_files {args[1]}
	}
}

(static-site) {
	encode gzip
	root * /srv{args[0]}
	file_server {
		pass_thru
	}
}

http://notebook.{$DOMAIN} {
	import static-site /notebook-root
}

http://app.notebook.{$DOMAIN} {
	import spa /notebook-clients /app.notebook/index.html
}

http://admin.notebook.{$DOMAIN} {
	import spa /notebook-clients /admin.notebook/index.html
}

# BEGIN WORKFLOW AREA client-subdomains FOR vue/add-spa



# END WORKFLOW AREA

# BEGIN WORKFLOW AREA static-subdomains FOR vue/add-static-site



# END WORKFLOW AREA

# Health check for the container (docker-compose.blue-green.yaml).
http://localhost {
	respond /health 200
}
