# Defaults baked into the monolith image (apply-env-defaults.sh); compose env_file wins.
ALLOW_DB_CREATION=true
CLIENT_SUBDOMAINS=,auth,app,admin,grafana,account
DEPLOYMENT_NAME=production
DOMAIN=notebook.scotterickson.info
NODE_ENV=production
PROTOCOL=https
ADMIN_EMAILS=admin@notebook.scotterickson.info

KRATOS_HANDLER_HTTP_HOST=notebook-monolith:3000
TZ=UTC

NOTEBOOK_SERVICE_HTTP_HOST=notebook-monolith:3001

LOKI_HOSTNAME=loki
LOKI_PORT=3100