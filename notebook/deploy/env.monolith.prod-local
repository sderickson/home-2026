# Monolith env for the prod-local stack (also read by builds/web to build the clients).
ALLOW_DB_CREATION=true
CLIENT_SUBDOMAINS=notebook,app.notebook,admin.notebook
DEPLOYMENT_NAME=prodlocal
DOMAIN=docker.localhost
ADMIN_EMAILS=admin@notebook.docker.localhost
BREVO_API_KEY=
NODE_ENV=production
NOTEBOOK_DOMAIN=notebook.docker.localhost
NOTEBOOK_DOMAIN_REDIRECTS=http://dne.notebook.docker.localhost
NOTEBOOK_SERVICE_HTTP_HOST=notebook-monolith:3001
KRATOS_HANDLER_HTTP_HOST=notebook-monolith:3000
PROTOCOL=http
SENTRY_DSN=
TZ=UTC

# Caddy-specific
BLOCK_ADMIN_PAGES=false

LOKI_HOSTNAME=loki
LOKI_PORT=3100