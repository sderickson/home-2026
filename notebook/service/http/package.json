{
  "name": "@sderickson/notebook-http",
  "saf": {
    "kind": "http"
  },
  "description": "HTTP server for the notebook service",
  "type": "module",
  "exports": {
    "./http": "./http.ts",
    "./routers": "./routers.ts",
    "./test/slim-route-test": "./test/slim-route-test.ts",
    "./handlers/*": "./handlers/*.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@sderickson/notebook-db": "*",
    "@sderickson/notebook-service-common": "*",
    "@sderickson/notebook-spec": "*",
    "@saflib/drizzle": "*",
    "@saflib/express": "*",
    "@saflib/jobs-http": "*",
    "@saflib/monorepo": "*",
    "@saflib/node": "*",
    "@saflib/utils": "*"
  },
  "devDependencies": {
    "@sderickson/notebook-http-app": "*",
    "@sderickson/notebook-jobs": "*",
    "@saflib/jobs-db": "*",
    "@saflib/vitest": "*",
    "supertest": "^7.0.0"
  },
  "sideEffects": false,
  "imports": {
    "#handlers/*": "./handlers/*",
    "#test/*": "./test/*"
  }
}
