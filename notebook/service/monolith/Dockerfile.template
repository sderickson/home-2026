# syntax=docker/dockerfile:labs
FROM node:26-slim

RUN npm install -g npm@11.14.1

WORKDIR /app

#{ copy_packages }#
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev
#{ copy_src }#

WORKDIR /app/notebook/service/monolith

# Env defaults from the product's own deploy (deploy/env.defaults).
COPY ./notebook/deploy/env.defaults /etc/notebook/env.defaults
COPY ./notebook/deploy/scripts/apply-env-defaults.sh /usr/local/bin/apply-env-defaults.sh
RUN chmod +x /usr/local/bin/apply-env-defaults.sh

ENTRYPOINT ["/usr/local/bin/apply-env-defaults.sh"]
# node itself (not npm start) so it gets SIGTERM and shuts down gracefully:
# a blue-green deploy stops the old color that way.
CMD ["node", "--experimental-strip-types", "./run.ts"]
