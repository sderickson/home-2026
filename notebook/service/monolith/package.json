{
  "name": "@sderickson/notebook-monolith",
  "saf": {
    "kind": "app"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b",
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning ./run.ts",
    "test": "vitest run"
  },
  "exports": {
    "./env": "./env.ts",
    "./http": "./http.ts",
    "./run": "./run.ts"
  },
  "dependencies": {


    "@sderickson/notebook-audit": "*",
    "@sderickson/notebook-cron": "*",
    "@sderickson/notebook-db": "*",
    "@sderickson/notebook-http": "*",
    "@sderickson/notebook-http-app": "*",
    "@sderickson/notebook-jobs": "*",
    "@sderickson/notebook-kratos-handlers": "*",
    "@sderickson/notebook-service-common": "*",
    "@sderickson/notebook-spec": "*",
    "@saflib/env": "*",
    "@saflib/errors-service": "*",
    "@saflib/express": "*",
    "@saflib/jobs-http": "*",
    "@saflib/monorepo": "*",
    "@saflib/node": "*",
    "@saflib/ory-kratos-http": "*",
    "@saflib/secret-store": "*",
    "@saflib/vendors-loki": "*",
    "@saflib/vendors-sentry-node": "*"
  },
  "sideEffects": false,
  "imports": {
    "#env.ts": "./env.ts"
  },
  "devDependencies": {
    "@saflib/vitest": "*"
  }
}
