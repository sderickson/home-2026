{
  "extends": "@saflib/monorepo/tsconfig.json",
  "references": [
    {
      "path": "../../../saflib/audit/audit-db"
    },
    {
      "path": "../../../saflib/audit/audit-http"
    },
    {
      "path": "../../../saflib/drizzle"
    },
    {
      "path": "../../../saflib/env"
    },
    {
      "path": "../common"
    }
  ],
  "compilerOptions": {
    "outDir": "./dist/types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "rootDir": "."
  },
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results"
  ],
  "include": [
    "**/*.ts",
    "**/*.json"
  ]
}
