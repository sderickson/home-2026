{
  "openapi": "3.0.0",
  "info": {
    "title": "createMenu",
    "version": "1.0.0"
  },
  "paths": {
    "/menus": {
      "post": {
        "summary": "Create menu in a collection. Editor or owner on collection only. Recipe ids in groupings must belong to the same collection.",
        "operationId": "createMenu",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "collectionId",
                  "name",
                  "groupings"
                ],
                "properties": {
                  "collectionId": {
                    "type": "string",
                    "description": "Id of the collection this menu belongs to."
                  },
                  "name": {
                    "type": "string",
                    "description": "Human-readable name for the menu.",
                    "minLength": 1
                  },
                  "groupings": {
                    "$ref": "#/components/schemas/groupings"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created menu.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "menu"
                  ],
                  "properties": {
                    "menu": {
                      "$ref": "#/components/schemas/menu"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - e.g. recipeIds in groupings do not belong to the same collection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid auth headers, or not logged in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - caller must be editor or owner on the collection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Not found - collection does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "groupings": {
        "type": "array",
        "description": "Ordered categories; each has a name and ordered recipe ids (display order)",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Name of the grouping (e.g. appetizers, mains, desserts)",
              "example": "Mains",
              "minLength": 1
            },
            "recipeIds": {
              "type": "array",
              "description": "Recipe ids in this grouping, in display order",
              "items": {
                "type": "string"
              },
              "example": [
                "r1abc",
                "r2def"
              ]
            }
          },
          "required": [
            "name",
            "recipeIds"
          ]
        },
        "example": [
          {
            "name": "Starters",
            "recipeIds": [
              "r1abc"
            ]
          },
          {
            "name": "Mains",
            "recipeIds": [
              "r2def",
              "r3ghi"
            ]
          }
        ]
      },
      "menu": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the menu (short id from generateShortId)",
            "example": "K3m9_xR2"
          },
          "collectionId": {
            "type": "string",
            "description": "Id of the collection this menu belongs to",
            "example": "my-kitchen"
          },
          "name": {
            "type": "string",
            "description": "Human-readable name for the menu",
            "example": "Weeknight Dinners",
            "minLength": 1
          },
          "createdBy": {
            "type": "string",
            "description": "User id of the menu creator (short id)",
            "example": "a1b2c3d4"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the menu was created",
            "example": "2023-01-15T14:30:00Z"
          },
          "updatedBy": {
            "type": "string",
            "description": "User id of the last updater (short id)",
            "example": "a1b2c3d4"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the menu was last updated",
            "example": "2023-02-01T09:00:00Z"
          },
          "editedByUserIds": {
            "type": "array",
            "description": "User ids of everyone who has edited this menu (append on each edit)",
            "items": {
              "type": "string"
            },
            "example": [
              "a1b2c3d4",
              "e5f6g7h8"
            ]
          },
          "groupings": {
            "type": "array",
            "description": "Ordered categories; each has a name and ordered recipe ids (display order)",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Name of the grouping (e.g. appetizers, mains, desserts)",
                  "example": "Mains",
                  "minLength": 1
                },
                "recipeIds": {
                  "type": "array",
                  "description": "Recipe ids in this grouping, in display order",
                  "items": {
                    "type": "string"
                  },
                  "example": [
                    "r1abc",
                    "r2def"
                  ]
                }
              },
              "required": [
                "name",
                "recipeIds"
              ]
            },
            "example": [
              {
                "name": "Starters",
                "recipeIds": [
                  "r1abc"
                ]
              },
              {
                "name": "Mains",
                "recipeIds": [
                  "r2def",
                  "r3ghi"
                ]
              }
            ]
          }
        },
        "required": [
          "id",
          "collectionId",
          "name",
          "createdBy",
          "createdAt",
          "updatedBy",
          "updatedAt",
          "editedByUserIds",
          "groupings"
        ]
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      }
    }
  }
}