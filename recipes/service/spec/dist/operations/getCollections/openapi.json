{
  "openapi": "3.0.0",
  "info": {
    "title": "getCollections",
    "version": "1.0.0"
  },
  "paths": {
    "/collections/{id}": {
      "get": {
        "summary": "Get one collection by id. Caller must be a member (any role) and have validated email; creator always has access.",
        "operationId": "getCollections",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Collection id"
          }
        ],
        "responses": {
          "200": {
            "description": "The collection.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "collection"
                  ],
                  "properties": {
                    "collection": {
                      "$ref": "#/components/schemas/collection",
                      "description": "The collection."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid auth headers, or not logged in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - not a member or unvalidated email (creator excepted).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found - collection does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "collection": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier; user-specified (URL-safe) on create or server-generated short id",
            "example": "my-kitchen",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "description": "Human-readable name for the collection",
            "example": "My Kitchen",
            "minLength": 1
          },
          "createdBy": {
            "type": "string",
            "description": "User id of the collection creator (short id)",
            "example": "K3m9_xR2"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the collection was created",
            "example": "2023-01-15T14:30:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the collection was last updated",
            "example": "2023-02-01T09:00:00Z"
          }
        },
        "required": [
          "id",
          "name",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      }
    }
  }
}