{
  "openapi": "3.0.0",
  "info": {
    "title": "membersAddCollections",
    "version": "1.0.0"
  },
  "paths": {
    "/collections/{id}/members": {
      "post": {
        "summary": "Add a member to a collection (or update role if email already exists). Owner only.",
        "operationId": "membersAddCollections",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Collection id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "role"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Member's email address",
                    "example": "alice@example.com"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "owner",
                      "editor",
                      "viewer"
                    ],
                    "description": "Role to assign (or update if member already exists)",
                    "example": "editor"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Added or updated member.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "member"
                  ],
                  "properties": {
                    "member": {
                      "$ref": "#/components/schemas/collection-member",
                      "description": "The added or updated collection member."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid auth headers, or not logged in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - caller must be an owner of the collection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found - collection does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "collection-member": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the member record (short id)",
            "example": "K3m9_xR2"
          },
          "collectionId": {
            "type": "string",
            "description": "Id of the collection this member belongs to",
            "example": "my-kitchen"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Member's email address; must be validated for access (except creator)",
            "example": "alice@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "editor",
              "viewer"
            ],
            "description": "Member's role in the collection; creator is always owner and cannot be demoted",
            "example": "editor"
          },
          "isCreator": {
            "type": "boolean",
            "description": "True if this member created the collection; permanent owner, cannot be removed or demoted",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the member was added to the collection",
            "example": "2023-01-15T14:30:00Z"
          }
        },
        "required": [
          "id",
          "collectionId",
          "email",
          "role",
          "isCreator",
          "createdAt"
        ]
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      }
    }
  }
}