{
  "openapi": "3.0.0",
  "info": {
    "title": "sharedGetMenus",
    "version": "1.0.0"
  },
  "paths": {
    "/menus/{id}/shared": {
      "get": {
        "summary": "Load a menu for the public share page by id (no auth).",
        "description": "Returns the menu, every recipe in its groupings, those recipes' current versions, and their files, so the public share page can render both the menu and diner layouts in one request. Each file's downloadUrl is set by the handler to the shared recipe blob path (/recipes/{recipeId}/shared/files/{fileId}/blob), not the authenticated blob path. Groupings only list recipes that still exist.\n",
        "operationId": "sharedGetMenus",
        "tags": [
          "no-auth"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Menu id"
          }
        ],
        "responses": {
          "200": {
            "description": "Menu with its recipes, their current versions, and files for the public share page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "menu",
                    "recipes",
                    "currentVersions",
                    "files"
                  ],
                  "properties": {
                    "menu": {
                      "$ref": "#/components/schemas/menu"
                    },
                    "recipes": {
                      "type": "array",
                      "description": "Every recipe referenced in the menu's groupings.",
                      "items": {
                        "$ref": "#/components/schemas/recipe"
                      }
                    },
                    "currentVersions": {
                      "type": "array",
                      "description": "Current version of each recipe in `recipes` (match on recipeId).",
                      "items": {
                        "$ref": "#/components/schemas/recipe-version"
                      }
                    },
                    "files": {
                      "type": "array",
                      "description": "Files for every recipe in `recipes` (match on recipeId); empty array when none. downloadUrl points at the shared recipe blob path.",
                      "items": {
                        "$ref": "#/components/schemas/recipe-file-info"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found - no menu with that id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "menu": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the menu (short id from generateShortId)",
            "example": "K3m9_xR2"
          },
          "collectionId": {
            "type": "string",
            "description": "Id of the collection this menu belongs to",
            "example": "my-kitchen"
          },
          "name": {
            "type": "string",
            "description": "Human-readable name for the menu",
            "example": "Weeknight Dinners",
            "minLength": 1
          },
          "createdBy": {
            "type": "string",
            "description": "User id of the menu creator (short id)",
            "example": "a1b2c3d4"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the menu was created",
            "example": "2023-01-15T14:30:00Z"
          },
          "updatedBy": {
            "type": "string",
            "description": "User id of the last updater (short id)",
            "example": "a1b2c3d4"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the menu was last updated",
            "example": "2023-02-01T09:00:00Z"
          },
          "editedByUserIds": {
            "type": "array",
            "description": "User ids of everyone who has edited this menu (append on each edit)",
            "items": {
              "type": "string"
            },
            "example": [
              "a1b2c3d4",
              "e5f6g7h8"
            ]
          },
          "groupings": {
            "type": "array",
            "description": "Ordered categories; each has a name and ordered recipe ids (display order)",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Name of the grouping (e.g. appetizers, mains, desserts)",
                  "example": "Mains",
                  "minLength": 1
                },
                "recipeIds": {
                  "type": "array",
                  "description": "Recipe ids in this grouping, in display order",
                  "items": {
                    "type": "string"
                  },
                  "example": [
                    "r1abc",
                    "r2def"
                  ]
                }
              },
              "required": [
                "name",
                "recipeIds"
              ]
            },
            "example": [
              {
                "name": "Starters",
                "recipeIds": [
                  "r1abc"
                ]
              },
              {
                "name": "Mains",
                "recipeIds": [
                  "r2def",
                  "r3ghi"
                ]
              }
            ]
          }
        },
        "required": [
          "id",
          "collectionId",
          "name",
          "createdBy",
          "createdAt",
          "updatedBy",
          "updatedAt",
          "editedByUserIds",
          "groupings"
        ]
      },
      "recipe": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the recipe",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "title": {
            "type": "string",
            "description": "Recipe title",
            "example": "Classic Chocolate Chip Cookies"
          },
          "subtitle": {
            "type": "string",
            "description": "Subtitle shown on menus and list views",
            "example": "Crispy edges, chewy centers"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Optional longer description shown on recipe detail (not on menu)",
            "example": "A crowd-pleasing recipe that works every time. Best with room-temperature butter."
          },
          "createdBy": {
            "type": "string",
            "description": "User id of the creator",
            "example": "a1b2c3d4-e89b-12d3-a456-426614174001"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the recipe was created",
            "example": "2023-01-15T14:30:00Z"
          },
          "updatedBy": {
            "type": "string",
            "description": "User id of the last updater",
            "example": "a1b2c3d4-e89b-12d3-a456-426614174001"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the recipe was last updated",
            "example": "2023-02-01T09:00:00Z"
          },
          "currentVersionId": {
            "type": "string",
            "description": "Optional id of the current/latest version for display",
            "example": "b2c3d4e5-e89b-12d3-a456-426614174002"
          }
        },
        "required": [
          "id",
          "title",
          "subtitle",
          "createdBy",
          "createdAt",
          "updatedBy",
          "updatedAt"
        ]
      },
      "recipe-version": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this recipe version",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "recipeId": {
            "type": "string",
            "description": "Id of the recipe this version belongs to",
            "example": "a1b2c3d4-e89b-12d3-a456-426614174001"
          },
          "content": {
            "type": "object",
            "description": "Version body — structured ingredients and markdown instructions",
            "properties": {
              "ingredients": {
                "type": "array",
                "description": "List of ingredients; quantity and unit are strings (e.g. \"2+1/3\", \"cups\")",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "quantity",
                    "unit"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "Ingredient name",
                      "example": "All-purpose flour"
                    },
                    "quantity": {
                      "type": "string",
                      "description": "Quantity as string to support values like \"1/3\", \"2+1/3\"",
                      "example": "2+1/3"
                    },
                    "unit": {
                      "type": "string",
                      "description": "Unit of measure (unrestricted string)",
                      "example": "cups"
                    }
                  }
                },
                "example": [
                  {
                    "name": "All-purpose flour",
                    "quantity": "2",
                    "unit": "cups"
                  },
                  {
                    "name": "Butter",
                    "quantity": "1/2",
                    "unit": "cup"
                  }
                ]
              },
              "instructionsMarkdown": {
                "type": "string",
                "description": "Recipe instructions in markdown",
                "example": "1. Preheat oven to 350°F.\n2. Mix dry ingredients..."
              }
            },
            "required": [
              "ingredients",
              "instructionsMarkdown"
            ],
            "example": {
              "ingredients": [
                {
                  "name": "All-purpose flour",
                  "quantity": "2",
                  "unit": "cups"
                }
              ],
              "instructionsMarkdown": "1. Preheat oven to 350°F.\n2. Mix dry ingredients."
            }
          },
          "isLatest": {
            "type": "boolean",
            "description": "Whether this version is the current one for the recipe (only one per recipe is true)",
            "example": true
          },
          "createdBy": {
            "type": "string",
            "description": "User id of the creator of this version",
            "example": "a1b2c3d4-e89b-12d3-a456-426614174001"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When this version was created",
            "example": "2023-01-15T14:30:00Z"
          }
        },
        "required": [
          "id",
          "recipeId",
          "content",
          "isLatest",
          "createdBy",
          "createdAt"
        ]
      },
      "recipe-file-info": {
        "type": "object",
        "description": "Metadata for one file attached to a recipe. Uses SAF file metadata (blob_name, file_original_name, mimetype, size, created_at, updated_at).",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the file record",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "recipeId": {
            "type": "string",
            "description": "Id of the recipe this file is attached to",
            "example": "a1b2c3d4-e89b-12d3-a456-426614174001"
          },
          "blobName": {
            "type": "string",
            "description": "Storage blob name (Azure) for the file",
            "example": "recipes/a1b2c3d4-e89b-12d3-a456-426614174001/123e4567-e89b-12d3-a456-426614174000.pdf"
          },
          "fileOriginalName": {
            "type": "string",
            "description": "Original filename as provided on upload",
            "example": "grandmas-cookies.pdf"
          },
          "mimetype": {
            "type": "string",
            "description": "MIME type of the file",
            "example": "application/pdf"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "description": "File size in bytes",
            "example": 102400
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the file was uploaded",
            "example": "2023-01-15T14:30:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the file metadata was last updated",
            "example": "2023-01-15T14:30:00Z"
          },
          "uploadedBy": {
            "type": "string",
            "nullable": true,
            "description": "User id of the uploader (optional)",
            "example": "a1b2c3d4-e89b-12d3-a456-426614174001"
          },
          "downloadUrl": {
            "type": "string",
            "format": "uri",
            "description": "Full URL to download or view the file (API base + /recipes/:id/files/:fileId/blob)",
            "example": "https://api.recipes.example.com/recipes/a1b2c3d4-e89b-12d3-a456-426614174001/files/123e4567-e89b-12d3-a456-426614174000/blob"
          },
          "unsplashAttribution": {
            "$ref": "#/components/schemas/unsplash-attribution",
            "description": "When present, the file was sourced from Unsplash; frontend must show attribution (e.g. full-size view). Omitted when file is from upload."
          }
        },
        "required": [
          "id",
          "recipeId",
          "blobName",
          "fileOriginalName",
          "mimetype",
          "size",
          "createdAt",
          "updatedAt"
        ]
      },
      "unsplash-attribution": {
        "type": "object",
        "description": "Minimal fields needed to attribute an Unsplash photo: photographer and links with UTM params per Unsplash API requirements. Shown when displaying Unsplash-sourced recipe files (e.g. full-size view).",
        "properties": {
          "photographerName": {
            "type": "string",
            "description": "Display name of the photographer",
            "example": "Jane Doe"
          },
          "photographerProfileUrl": {
            "type": "string",
            "format": "uri",
            "description": "Unsplash profile URL with UTM params (utm_source, utm_medium=referral)",
            "example": "https://unsplash.com/@janedoe?utm_source=your_app_name&utm_medium=referral"
          },
          "unsplashSourceUrl": {
            "type": "string",
            "format": "uri",
            "description": "Unsplash source link with UTM params for \"on Unsplash\" attribution",
            "example": "https://unsplash.com?utm_source=your_app_name&utm_medium=referral"
          }
        },
        "required": [
          "photographerName",
          "photographerProfileUrl",
          "unsplashSourceUrl"
        ]
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      }
    }
  }
}