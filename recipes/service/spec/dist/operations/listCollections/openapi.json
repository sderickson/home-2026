{
  "openapi": "3.0.0",
  "info": {
    "title": "listCollections",
    "version": "1.0.0"
  },
  "paths": {
    "/collections": {
      "get": {
        "summary": "List collections the current user is a member of (any role). Returns only collections where the user's email is in collection_member and (email is validated OR user is creator). Includes menus for each collection (viewers see public menus only; editors/owners see all).",
        "operationId": "listCollections",
        "responses": {
          "200": {
            "description": "Collections the current user is a member of, their members, and menus for those collections.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "collections",
                    "members",
                    "menus"
                  ],
                  "properties": {
                    "collections": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/collection"
                      },
                      "description": "List of collections the user is a member of."
                    },
                    "members": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/collection-member"
                      },
                      "description": "All members for all returned collections."
                    },
                    "menus": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/menu"
                      },
                      "description": "All menus for the returned collections (viewers see public only; editors/owners see all)."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - missing or invalid auth headers, or not logged in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - user does not have required privileges.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "collection": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier; user-specified (URL-safe) on create or server-generated short id",
            "example": "my-kitchen",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "description": "Human-readable name for the collection",
            "example": "My Kitchen",
            "minLength": 1
          },
          "createdBy": {
            "type": "string",
            "description": "User id of the collection creator (short id)",
            "example": "K3m9_xR2"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the collection was created",
            "example": "2023-01-15T14:30:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the collection was last updated",
            "example": "2023-02-01T09:00:00Z"
          }
        },
        "required": [
          "id",
          "name",
          "createdBy",
          "createdAt",
          "updatedAt"
        ]
      },
      "collection-member": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the member record (short id)",
            "example": "K3m9_xR2"
          },
          "collectionId": {
            "type": "string",
            "description": "Id of the collection this member belongs to",
            "example": "my-kitchen"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "Member's email address; must be validated for access (except creator)",
            "example": "alice@example.com"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "editor",
              "viewer"
            ],
            "description": "Member's role in the collection; creator is always owner and cannot be demoted",
            "example": "editor"
          },
          "isCreator": {
            "type": "boolean",
            "description": "True if this member created the collection; permanent owner, cannot be removed or demoted",
            "example": false
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the member was added to the collection",
            "example": "2023-01-15T14:30:00Z"
          }
        },
        "required": [
          "id",
          "collectionId",
          "email",
          "role",
          "isCreator",
          "createdAt"
        ]
      },
      "menu": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the menu (short id from generateShortId)",
            "example": "K3m9_xR2"
          },
          "collectionId": {
            "type": "string",
            "description": "Id of the collection this menu belongs to",
            "example": "my-kitchen"
          },
          "name": {
            "type": "string",
            "description": "Human-readable name for the menu",
            "example": "Weeknight Dinners",
            "minLength": 1
          },
          "createdBy": {
            "type": "string",
            "description": "User id of the menu creator (short id)",
            "example": "a1b2c3d4"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the menu was created",
            "example": "2023-01-15T14:30:00Z"
          },
          "updatedBy": {
            "type": "string",
            "description": "User id of the last updater (short id)",
            "example": "a1b2c3d4"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the menu was last updated",
            "example": "2023-02-01T09:00:00Z"
          },
          "editedByUserIds": {
            "type": "array",
            "description": "User ids of everyone who has edited this menu (append on each edit)",
            "items": {
              "type": "string"
            },
            "example": [
              "a1b2c3d4",
              "e5f6g7h8"
            ]
          },
          "groupings": {
            "type": "array",
            "description": "Ordered categories; each has a name and ordered recipe ids (display order)",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Name of the grouping (e.g. appetizers, mains, desserts)",
                  "example": "Mains",
                  "minLength": 1
                },
                "recipeIds": {
                  "type": "array",
                  "description": "Recipe ids in this grouping, in display order",
                  "items": {
                    "type": "string"
                  },
                  "example": [
                    "r1abc",
                    "r2def"
                  ]
                }
              },
              "required": [
                "name",
                "recipeIds"
              ]
            },
            "example": [
              {
                "name": "Starters",
                "recipeIds": [
                  "r1abc"
                ]
              },
              {
                "name": "Mains",
                "recipeIds": [
                  "r2def",
                  "r3ghi"
                ]
              }
            ]
          }
        },
        "required": [
          "id",
          "collectionId",
          "name",
          "createdBy",
          "createdAt",
          "updatedBy",
          "updatedAt",
          "editedByUserIds",
          "groupings"
        ]
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "A short, machine-readable error code, for when HTTP status codes are not sufficient."
          },
          "message": {
            "type": "string",
            "description": "A human-readable description of the error.",
            "example": "The requested resource could not be found."
          }
        }
      }
    }
  }
}