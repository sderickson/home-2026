{
  "extends": "@saflib/monorepo/tsconfig.json",
  "references": [
    { "path": "../../../saflib/drizzle" },
    { "path": "../../../saflib/monorepo" },
    { "path": "../../../saflib/node" },
    { "path": "../../../saflib/ops/ops-db" },
