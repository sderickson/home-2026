# syntax=docker/dockerfile:labs
FROM node:24-slim

RUN npm install -g npm@11.14.1

WORKDIR /app

#{ copy_packages }#
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev
#{ copy_src }#

WORKDIR /app/recipes/service/monolith
# node itself (not npm start) so it gets SIGTERM and shuts down gracefully:
# a blue-green deploy stops the old color that way.
CMD ["node", "--experimental-strip-types", "./run.ts"]
