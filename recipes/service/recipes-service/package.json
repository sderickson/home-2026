{
  "name": "@sderickson/recipes-service",
  "description": "Service package for recipes",
  "saf": {
    "kind": "app"
  },
  "type": "module",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "start": "node --experimental-strip-types ./run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "healthcheck": "node --experimental-strip-types ./bin/healthcheck",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@saflib/drizzle": "*",
    "@saflib/env": "*",
    "@saflib/express": "*",
    "@saflib/jobs-http": "*",
    "@saflib/monorepo": "*",
    "@saflib/node": "*",
    "@saflib/vendors-brevo": "*",
    "@saflib/vendors-infisical": "*",
    "@sderickson/recipes-cron": "*",
    "@sderickson/recipes-db": "*",
    "@sderickson/recipes-http": "*",
    "@sderickson/recipes-http-app": "*",
    "@sderickson/recipes-jobs": "*",
    "@sderickson/recipes-service-common": "*",
    "@sderickson/recipes-spec": "*",
    "@sderickson/recipes-unsplash": "*"
  },
  "devDependencies": {
    "@saflib/vitest": "*"
  }
}
