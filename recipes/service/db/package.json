{
  "name": "@sderickson/recipes-db",
  "saf": {
    "kind": "db"
  },
  "description": "Database package for recipes.",
  "private": true,
  "type": "module",
  "exports": {
    "./instances": "./instances.ts",
    "./errors": "./errors.ts",
    "./types": "./types.ts",
    "./queries/*": "./queries/*.ts",
    "./schemas/*": "./schemas/*.ts",
    "./startup/fix-text-timestamps": "./startup/fix-text-timestamps.ts"
  },
  "imports": {
    "#errors.ts": "./errors.ts",
    "#instances.ts": "./instances.ts",
    "#queries/*": "./queries/*",
    "#schemas/*": "./schemas/*",
    "#types.ts": "./types.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate": "drizzle-kit generate",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@saflib/drizzle": "*",
    "@saflib/utils": "*"
  },
  "devDependencies": {
    "@saflib/vitest": "*"
  },
  "sideEffects": false
}
