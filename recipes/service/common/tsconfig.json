{
  "extends": "@saflib/monorepo/tsconfig.json",
  "references": [
    {
      "path": "../../../saflib/email/email-service"
    },
    {
      "path": "../../../saflib/env"
    },
    {
      "path": "../../../saflib/monorepo"
    },
    {
      "path": "../../../saflib/node"
    },
    {
      "path": "../../../saflib/object-store"
    },
    {
      "path": "../../../saflib/secret-store"
    },
    {
      "path": "../../../saflib/vendors/brevo"
    },
    {
      "path": "../../../saflib/vendors/infisical"
    },
    {
      "path": "../integrations/unsplash"
    }
  ],
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results",
    "workflows/template/**",
    "workflows/templates/**",
    "**/workflows/template/**",
    "**/workflows/templates/**"
  ],
  "include": [
    "**/*.ts",
    "**/*.json"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist/types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true
  }
}
