{
  "extends": "@saflib/monorepo/tsconfig.json",
  "exclude": [
    "node_modules",
    "dist/types",
    "e2e",
    "playwright-report",
    "test-results"
  ],
  "include": [
    "**/*.ts",
    "**/*.json"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist/types",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "references": [
    {
      "path": "../../saflib/drizzle"
    },
    {
      "path": "../../saflib/express"
    },
    {
      "path": "../../saflib/integrations"
    },
    {
      "path": "../../saflib/openapi"
    },
    {
      "path": "../../saflib/processes"
    },
    {
      "path": "../../saflib/sdk"
    },
    {
      "path": "../../saflib/vue"
    },
    {
      "path": "../../saflib/workflows"
    }
  ]
}
