# Recipes monolith for the prod-local recipes stack
# Same shape as remote-assets/env.recipes.config but DOMAIN=docker.localhost and local settings

ALLOW_DB_CREATION=true
CLIENT_SUBDOMAINS=,app,auth,account,admin,recipes,app.recipes,admin.recipes,account.recipes
DEPLOYMENT_NAME=prodlocal
DOMAIN=docker.localhost
MOCK_INTEGRATIONS=true
NODE_ENV=production
PROTOCOL=http
ADMIN_EMAILS=admin@docker.localhost

KRATOS_HANDLER_HTTP_HOST=recipes-monolith:3000

SERVICE_SUBDOMAINS=hub,api.recipes
TRADEMARK="Recipes"
TZ=UTC

RECIPES_SERVICE_HTTP_HOST=recipes-monolith:3002

# Integrations (prod-local)
SENTRY_DSN=mock
UNSPLASH_API_KEY=mock
BREVO_API_KEY=mock
INFISICAL_TOKEN=mock
