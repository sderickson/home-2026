# Recipes routes on the platform's edge. Registered by this deploy
# (`saf-deploy up`); uses the edge's snippets and env (common.Caddyfile, env.caddy).

{$PROTOCOL}://recipes.{$DOMAIN} {
	import security-headers-marketing
	reverse_proxy recipes-web:80
}

{$PROTOCOL}://app.recipes.{$DOMAIN} {
	import security-headers
	reverse_proxy recipes-web:80
}

{$PROTOCOL}://admin.recipes.{$DOMAIN} {
	import security-headers
	reverse_proxy recipes-web:80
}

{$PROTOCOL}://account.recipes.{$DOMAIN} {
	import security-headers
	reverse_proxy recipes-web:80
}

# API: forward_auth to Kratos whoami, then proxy to the recipes service.
{$PROTOCOL}://api.recipes.{$DOMAIN} {
	import transport-security
	import cors {$CORS_ORIGIN_ALLOWLIST}
	@public_monolith path /health /csp-violations /errors/record /product-events/record /dev/logs /dev/logs/stream /admin/metrics/snapshot /admin/product-events /admin/errors /recipes/*/shared /recipes/*/shared/files/*/blob /menus/*/shared
	handle @public_monolith {
		reverse_proxy recipes-monolith:3002 {
			import reverse_proxy_common
		}
	}
	import kratos-api-proxy recipes-monolith:3002
}
