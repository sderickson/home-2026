# Recipes monolith (recipes deploy). Kratos is the platform's, on the edge
# network (KRATOS_ADMIN_API_URL defaults to http://kratos:4434).

ALLOW_DB_CREATION=true
CLIENT_SUBDOMAINS=,app,auth,account,admin,recipes,app.recipes,admin.recipes,account.recipes
DEPLOYMENT_NAME=production
DOMAIN=scotterickson.info
MOCK_INTEGRATIONS=false
NODE_ENV=production
PROTOCOL=https

# Courier callbacks go to the platform's hub monolith; this one isn't called.
KRATOS_HANDLER_HTTP_HOST=recipes-monolith:3000

SERVICE_SUBDOMAINS=hub,api.recipes
TRADEMARK="Recipes"
TZ=UTC

RECIPES_SERVICE_HTTP_HOST=recipes-monolith:3002

ADMIN_EMAILS=sderickson@gmail.com
