# Serves recipes' static files behind the platform's edge, which terminates
# TLS, adds security headers and proxies here with the Host header intact.
{
	admin off
	auto_https off
}

(spa) {
	encode gzip
	root * /srv{args[0]}
	file_server {
		pass_thru
	}
	@non-file expression path_regexp('^[^.]*$')
	handle @non-file {
		try_files {args[1]}
	}
}

# VitePress sites (cleanUrls: /path → /path.html)
(static-site) {
	encode gzip
	root * /srv{args[0]}
	try_files {path} {path}.html {path}/index.html
	file_server {
		pass_thru
	}
}

http://recipes.{$DOMAIN} {
	import static-site /recipes-static-root
}

http://app.recipes.{$DOMAIN} {
	import spa /recipes-clients /app.recipes/index.html
}

http://admin.recipes.{$DOMAIN} {
	import spa /recipes-clients /admin.recipes/index.html
}

http://account.recipes.{$DOMAIN} {
	import spa /recipes-clients /account.recipes/index.html
}

# Health check for the container (docker-compose.blue-green.yaml).
http://localhost {
	respond /health 200
}
