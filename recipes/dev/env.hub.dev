# Hub monolith in the recipes dev stack (hub-monolith). Same shape as
# hub/deploy/remote-assets/env.hub.config, with dev settings. Secrets (the
# Infisical credentials) come from ./.env, shared with the recipes monolith.

# @saflib/env
ALLOW_DB_CREATION=true
DEPLOYMENT_NAME=development
NODE_ENV=development
PROTOCOL=http
TZ=UTC

# Hub domain model
DOMAIN=docker.localhost
CLIENT_SUBDOMAINS=,app,auth,account,admin
ADMIN_EMAILS=sderickson@gmail.com

# @saflib/ory-kratos-http (Kratos' courier sends here)
KRATOS_HANDLER_HTTP_HOST=hub-monolith:3000

# @sderickson/hub-service
HUB_SERVICE_HTTP_HOST=hub-monolith:3001

SENTRY_DSN=mock
