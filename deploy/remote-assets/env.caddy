# Caddy env for hub domain model (single domain, Kratos + product APIs)
# Used by deploy/remote-assets/config/Caddyfile

DOMAIN=scotterickson.info
PROTOCOL=https
HUB_SERVICE_HTTP_HOST=monolith:3001
RECIPES_SERVICE_HTTP_HOST=monolith:3002

# CORS Origin RE2 allowlist ($$ → single $). Keep separate from DNS DOMAIN above.
CORS_ORIGIN_ALLOWLIST=^https://((app|admin|account)\.recipes|recipes|app|auth|admin|account)\.scotterickson\.info$$|^https://scotterickson\.info$$|^https://www\.scotterickson\.info$$

CSP_SCRIPT_SRC_EXTRA=https://kratos.scotterickson.info
# Recipe file blobs (api.recipes) + Unsplash picker thumbnails
CSP_IMG_SRC_EXTRA=https://api.recipes.scotterickson.info https://images.unsplash.com
CSP_CONNECT_SRC=https: wss:
CSP_REPORT_URI=https://api.recipes.scotterickson.info/csp-violations

# Optional: redirect old/wrong hostnames to main domain (comma-separated)
DOMAIN_REDIRECTS=http://dne.docker.localhost

BLOCK_ADMIN_PAGES=true
