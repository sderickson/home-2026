# Blog and resume static sites. The platform's edge proxies their hosts here
# (see remote-assets/caddy/clients.Caddyfile).
FROM caddy:2.11.8

COPY --from=#{ image @sderickson/clients-deploy/builds/blog }# /dist /srv/blog-client
COPY --from=#{ image @sderickson/clients-deploy/builds/resume }# /dist /srv/resume-client

COPY ./clients/deploy/builds/web/Caddyfile /etc/caddy/Caddyfile
