# Serves the blog and resume behind the platform's edge, which terminates TLS,
# adds security headers and proxies here with the Host header intact.
{
	admin off
	auto_https off
}

# VitePress sites (cleanUrls: /path → /path.html)
(static-site) {
	encode gzip
	root * /srv{args[0]}
	try_files {path} {path}.html {path}/index.html
	file_server {
		pass_thru
	}
}

http://blog.{$DOMAIN} {
	# Legacy /blog/<slug> → /<slug>
	@legacy_blog path_regexp legacy_blog ^/blog/([^/]+)/?$
	redir @legacy_blog /{re.legacy_blog.1} permanent
	import static-site /blog-client
}

http://resume.{$DOMAIN} {
	import static-site /resume-client
}

# Health check for the container (docker-compose.blue-green.yaml).
http://localhost {
	respond /health 200
}
